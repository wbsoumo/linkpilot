# Custom Error Documents & Directory Index Configuration
DirectoryIndex index.html index.php
ErrorDocument 404 /error-404.html
ErrorDocument 403 /error-403.html
ErrorDocument 401 /error-401.html

# Booking URL Rewriting
RewriteEngine On
RewriteRule ^m/([a-zA-Z0-9]+)/?$ dashboard/meet.html?id=$1 [L,QSA]
RewriteRule ^o/([a-zA-Z0-9]+)/?$ backend/api/crm/track_open.php?id=$1 [L,QSA]
RewriteRule ^c/([a-zA-Z0-9_-]+)/?$ backend/api/crm/track_click.php?id=$1 [L,QSA]
RewriteRule ^u/([a-zA-Z0-9_-]+)/?$ backend/api/crm/unsubscribe.php?id=$1 [L,QSA]

