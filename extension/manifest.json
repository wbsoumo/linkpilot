{
  "manifest_version": 3,
  "name": "LinkPilot AI",
  "version": "1.0",
  "description": "Generate personalized outreach emails, comments, and WhatsApp messages directly from LinkedIn posts.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://linkpilot.work/*"
  ],
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_icon": {
      "16": "logo.png",
      "32": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    },
    "default_popup": "popup.html",
    "default_title": "LinkPilot AI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "gemini-color.png",
        "logo.png"
      ],
      "matches": [
        "https://*.linkedin.com/*"
      ]
    }
  ]
}
